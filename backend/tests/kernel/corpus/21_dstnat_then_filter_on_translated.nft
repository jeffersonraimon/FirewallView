# kd: packets=70
table ip nat {
  chain prerouting {
    type nat hook prerouting priority -100;
    iifname "ether1-wan" tcp dport 8080 dnat to 192.168.1.50:80
    iifname "ether1-wan" tcp dport 2200 dnat to 192.168.1.100:22
  }
}
table inet filter {
  chain forward {
    type filter hook forward priority 0; policy drop;
    ip daddr 192.168.1.50 tcp dport 80 accept
    tcp dport 8080 accept
    iifname "ether1-wan" tcp dport 22 accept
  }
  chain input {
    type filter hook input priority 0; policy drop;
    tcp dport 8080 accept
  }
}
