# kd: packets=80
# Generated by iptables-save
*nat
:PREROUTING ACCEPT [0:0]
:INPUT ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]
:POSTROUTING ACCEPT [0:0]
-A PREROUTING -i ether1-wan -p tcp --dport 8080 -j DNAT --to-destination 192.168.1.50:80
-A PREROUTING -d 203.0.113.1 -p tcp --dport 2222 -j DNAT --to-destination 192.168.1.200:22
-A PREROUTING -i ether2-lan -p tcp --dport 80 -j REDIRECT --to-ports 8080
-A POSTROUTING -s 192.168.1.100 -o ether1-wan -j SNAT --to-source 203.0.113.1
-A POSTROUTING -s 192.168.1.200 -p tcp --dport 443 -j SNAT --to-source 203.0.113.1:40000
-A POSTROUTING -o ether1-wan -j MASQUERADE
COMMIT
*filter
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]
-A INPUT -p tcp --dport 8080 -j ACCEPT
-A FORWARD -m conntrack --ctstate DNAT -j ACCEPT
-A FORWARD -i ether2-lan -j ACCEPT
COMMIT
