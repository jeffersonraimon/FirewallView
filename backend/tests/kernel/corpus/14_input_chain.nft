# kd: packets=70
table inet filter {
  chain input {
    type filter hook input priority 0; policy drop;
    ct state established,related accept
    iifname "ether2-lan" tcp dport 22 accept
    iifname "ether2-lan" ip protocol icmp accept
    iifname "ether1-wan" tcp dport { 80, 443 } accept
    ip saddr 198.51.100.0/24 drop
    udp dport 53 accept
    ip6 saddr fd00:1::/64 accept
  }
}
