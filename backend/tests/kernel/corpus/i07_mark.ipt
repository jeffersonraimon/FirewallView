# kd: packets=70
# Generated by iptables-save
*mangle
:PREROUTING ACCEPT [0:0]
:INPUT ACCEPT [0:0]
:FORWARD ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]
:POSTROUTING ACCEPT [0:0]
-A PREROUTING -s 192.168.1.100 -j MARK --set-mark 16
-A PREROUTING -p tcp --dport 25 -j MARK --set-mark 32
COMMIT
*filter
:INPUT ACCEPT [0:0]
:FORWARD ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]
-A FORWARD -m mark --mark 16 -j DROP
-A FORWARD -m mark ! --mark 32 -p tcp --dport 8080 -j DROP
COMMIT
