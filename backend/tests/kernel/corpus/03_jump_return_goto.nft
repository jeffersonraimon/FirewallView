# kd: packets=70
table inet filter {
  chain forward {
    type filter hook forward priority 0; policy drop;
    ip saddr 192.168.1.0/24 jump lan_rules
    tcp dport 22 jump ssh_rules
    ip saddr 203.0.113.10 goto wan_rules
    drop
  }
  chain lan_rules {
    tcp dport 25 drop
    udp dport 53 return
    tcp dport 80 accept
    ip daddr 198.51.100.7 accept
  }
  chain ssh_rules {
    ip saddr 192.168.1.50 accept
    return
  }
  chain wan_rules {
    tcp dport 443 accept
  }
}
