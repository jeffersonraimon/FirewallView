# kd: packets=60
# Generated by iptables-save
*filter
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]
-A INPUT -i ether+ -p udp --dport 123 -j ACCEPT
-A INPUT ! -i ether1-wan -j ACCEPT
-A FORWARD -i ether+ -o ether1-wan -d 203.0.113.10 -j ACCEPT
-A FORWARD -i ether1-wan -o ether2-lan -p tcp --dport 8080 -j ACCEPT
-A FORWARD ! -o ether1-wan -s 203.0.113.99 -j ACCEPT
COMMIT
