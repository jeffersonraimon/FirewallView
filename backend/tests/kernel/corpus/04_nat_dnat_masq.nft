# kd: packets=80
table ip nat {
  chain prerouting {
    type nat hook prerouting priority -100; policy accept;
    iifname "ether1-wan" tcp dport 8080 dnat to 192.168.1.50:80
    iifname "ether1-wan" udp dport 5353 dnat to 192.168.1.100:53
    ip daddr 203.0.113.1 tcp dport 2222 dnat to 192.168.1.200:22
  }
  chain postrouting {
    type nat hook postrouting priority 100; policy accept;
    oifname "ether1-wan" masquerade
  }
}
table inet filter {
  chain forward {
    type filter hook forward priority 0; policy drop;
    ct status dnat accept
    iifname "ether2-lan" accept
  }
  chain input {
    type filter hook input priority 0; policy drop;
    tcp dport 22 ip saddr 192.168.1.0/24 accept
  }
}
