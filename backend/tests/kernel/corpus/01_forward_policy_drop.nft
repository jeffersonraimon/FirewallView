# kd: packets=70
table inet filter {
  chain forward {
    type filter hook forward priority 0; policy drop;
    ct state established,related accept
    iifname "ether2-lan" oifname "ether1-wan" tcp dport { 80, 443 } accept
    iifname "ether2-lan" oifname "ether1-wan" udp dport 53 accept
    iifname "ether2-lan" ip saddr 192.168.1.100 accept
    ip6 saddr fd00:1::/64 icmpv6 type echo-request accept
    tcp dport 8000-8100 ip daddr 192.168.1.200 accept
  }
}
