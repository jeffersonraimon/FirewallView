# kd: packets=70
# Generated by iptables-save
*filter
:INPUT ACCEPT [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]
:ALLOWLAN - [0:0]
-A FORWARD -s 192.168.1.0/24 -j ALLOWLAN
-A ALLOWLAN -p tcp -m multiport --dports 80,443 -j ACCEPT
-A ALLOWLAN -p udp --dport 53 -j ACCEPT
COMMIT
*nat
:PREROUTING ACCEPT [0:0]
:INPUT ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]
:POSTROUTING ACCEPT [0:0]
-A POSTROUTING -s 192.168.1.0/24 -o ether1-wan -j MASQUERADE
COMMIT
