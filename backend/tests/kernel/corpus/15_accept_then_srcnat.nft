# kd: packets=70
table inet filter {
  chain forward {
    type filter hook forward priority 0; policy drop;
    ip saddr 192.168.1.0/24 jump allow_lan
  }
  chain allow_lan {
    tcp dport { 80, 443 } accept
    udp dport 53 accept
  }
}
table ip nat {
  chain postrouting {
    type nat hook postrouting priority 100;
    ip saddr 192.168.1.0/24 oifname "ether1-wan" masquerade
  }
}
