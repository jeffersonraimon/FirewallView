# kd: packets=70
# Generated by iptables-save
*nat
:PREROUTING ACCEPT [0:0]
:INPUT ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]
:POSTROUTING ACCEPT [0:0]
:PORTFWD - [0:0]
-A PREROUTING -i ether1-wan -j PORTFWD
-A PORTFWD -p tcp --dport 8080 -j DNAT --to-destination 192.168.1.50:80
-A PORTFWD -p tcp --dport 2200 -j DNAT --to-destination 192.168.1.100:22
-A PORTFWD -p udp --dport 53 -j RETURN
-A PREROUTING -i ether1-wan -p udp --dport 53 -j DNAT --to-destination 192.168.1.200
COMMIT
*filter
:INPUT ACCEPT [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]
-A FORWARD -d 192.168.1.50 -p tcp --dport 80 -j ACCEPT
-A FORWARD -d 192.168.1.200 -p udp --dport 53 -j ACCEPT
-A FORWARD -i ether1-wan -p tcp --dport 22 -j ACCEPT
COMMIT
