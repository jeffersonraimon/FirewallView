# kd: packets=60
table inet filter {
  chain forward {
    type filter hook forward priority 0; policy accept;
    tcp dport 25 reject with tcp reset
    udp dport 53 ip daddr 198.51.100.7 reject
    ip saddr 192.168.1.100 reject with icmp type admin-prohibited
    ip6 saddr fd00:1::64 reject
    tcp dport 23 drop
  }
  chain input {
    type filter hook input priority 0; policy accept;
    tcp dport 23 reject
    udp dport 5000-5100 drop
  }
}
