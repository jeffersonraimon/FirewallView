# kd: packets=60
# Generated by iptables-save
*filter
:INPUT ACCEPT [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]
-A INPUT -m conntrack ! --ctstate NEW -j DROP
-A INPUT -m state --state NEW -p tcp --dport 23 -j DROP
-A FORWARD -m conntrack --ctstate NEW -p tcp --dport 22 -j ACCEPT
-A FORWARD -m conntrack --ctstate INVALID -j DROP
-A FORWARD -m state --state ESTABLISHED,RELATED -j ACCEPT
-A FORWARD -m conntrack --ctstate NEW -s 192.168.1.0/24 -j ACCEPT
COMMIT
