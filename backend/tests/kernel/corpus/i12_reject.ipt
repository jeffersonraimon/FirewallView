# kd: packets=60
# Generated by iptables-save
*filter
:INPUT ACCEPT [0:0]
:FORWARD ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]
-A INPUT -p tcp --dport 23 -j REJECT --reject-with tcp-reset
-A INPUT -p udp --dport 5000:5100 -j DROP
-A FORWARD -p tcp --dport 25 -j REJECT --reject-with tcp-reset
-A FORWARD -s 192.168.1.100 -j REJECT --reject-with icmp-admin-prohibited
-A FORWARD -p udp --dport 53 -d 198.51.100.7 -j REJECT
-A FORWARD -p tcp --dport 23 -j DROP
COMMIT
