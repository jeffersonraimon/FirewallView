# kd: packets=60
# Generated by iptables-save
*filter
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]
-A INPUT -p icmp -m icmp --icmp-type echo-request -j ACCEPT
-A FORWARD -p icmp --icmp-type 8 -s 192.168.1.50 -j ACCEPT
-A FORWARD -p icmp --icmp-type 0 -j ACCEPT
-A FORWARD -p tcp --tcp-flags SYN,ACK SYN --dport 80 -j ACCEPT
COMMIT
