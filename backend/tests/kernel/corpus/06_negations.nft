# kd: packets=70
table inet filter {
  chain forward {
    type filter hook forward priority 0; policy accept;
    ip saddr != 192.168.1.0/24 tcp dport 22 drop
    tcp dport != { 22, 80, 443 } ip daddr 203.0.113.10 drop
    iifname != "ether2-lan" ip daddr 192.168.1.100 drop
    ip daddr != 203.0.113.0/24 udp dport 53 drop
    meta l4proto != tcp ip saddr 192.168.1.200 drop
    tcp sport != 40000 ip saddr 192.168.1.50 tcp dport 8080 drop
  }
}
