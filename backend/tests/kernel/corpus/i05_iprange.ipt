# kd: packets=60
# Generated by iptables-save
*filter
:INPUT ACCEPT [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]
-A FORWARD -m iprange --src-range 192.168.1.64-192.168.1.127 -j ACCEPT
-A FORWARD -m iprange --dst-range 198.51.100.10-198.51.100.20 -p tcp -j ACCEPT
-A FORWARD -s 192.168.1.200 -j ACCEPT
COMMIT
