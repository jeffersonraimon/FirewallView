# kd: packets=70
# Generated by iptables-save
*filter
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]
-A INPUT -i ether2-lan -p tcp --dport 22 -j ACCEPT
-A INPUT -p icmp -j ACCEPT
-A INPUT -s 198.51.100.0/24 -j DROP
-A FORWARD -i ether2-lan -o ether1-wan -p tcp -m multiport --dports 80,443 -j ACCEPT
-A FORWARD -i ether2-lan -s 192.168.1.100 -j ACCEPT
-A FORWARD -d 203.0.113.20 -p udp --dport 53 -j ACCEPT
-A FORWARD -p tcp --dport 1000:2000 -d 192.168.1.200 -j ACCEPT
COMMIT
